{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/proxy?path="
    },
    {
      "source": "/:path*",
      "destination": "/api/proxy?path=:path*"
    }
  ],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  }
}
